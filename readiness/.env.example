# Readiness Assistant Environment Configuration

# LLM Configuration (Google Gemini / Gemma 4)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=models/gemma-4-26b-a4b-it
LLM_FALLBACK_MODEL=models/gemma-4-31b-it
FIRST_TOKEN_TIMEOUT_MS=2500

# Optional OpenUI / Thesys Gateway (if configured)
THESYS_API_KEY=

# Security & Authentication
JWT_SECRET=replace_with_a_secure_jwt_secret_key_32_chars
DEMO_TECH_PASSWORD=tech123
DEMO_SUPERVISOR_PASSWORD=super123

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///data/readiness.db
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=demo_redis_secret_pass

# Optional Neo4j Graph Mirror (compose profile: graph)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=demo_neo4j_secret_pass
ENABLE_NEO4J=false

# Network & CORS
PORT=8000
DASHBOARD_ORIGIN=http://localhost:3000
